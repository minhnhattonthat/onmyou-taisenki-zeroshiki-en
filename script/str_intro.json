  {
   "id": "12812C",
   "jp": "時をさかのぼること１０００年",
   "en": "One thousand years in the past,",
   "max": 32,
   "ptrs": 2
  },
  {
   "id": "12814C",
   "jp": "妖怪がОП（ばっこ）する世　",
   "en": "in an age when yokai ran rampant,",
   "max": 32,
   "notes": "gaiji О=跋 П=扈"
  },
  {
   "id": "12816C",
   "jp": "　　　　　　　　　　　　　　",
   "en": "",
   "max": 32,
   "ptrs": 5
  },
  {
   "id": "12818C",
   "jp": "己を鍛錬し、伝説の「式神」と",
   "en": "warriors trained, bound legendary \"shikigami\"",
   "max": 32
  },
  {
   "id": "1281AC",
   "jp": "契約を結び、妖怪に立ち向かう",
   "en": "to them by contract, and fought the yokai.",
   "max": 32
  },
  {
   "id": "1281CC",
   "jp": "ひとつの集団があった　　　　",
   "en": "They were one band of fighters,",
   "max": 32
  },
  {
   "id": "1281EC",
   "jp": "その名を「闘神士」という　　",
   "en": "and their name was the \"Tojinshi\".",
   "max": 32
  },
  {
   "id": "12820C",
   "jp": "「闘神士」により世の中には　",
   "en": "Thanks to the \"Tojinshi\", it seemed",
   "max": 32
  },
  {
   "id": "12822C",
   "jp": "平和が訪れたかに見えた　　　",
   "en": "that peace had come to the world.",
   "max": 32
  },
  {
   "id": "12824C",
   "jp": "しかし、強すぎる「式神」の力",
   "en": "But the overwhelming power of \"shikigami\"",
   "max": 32
  },
  {
   "id": "12826C",
   "jp": "は「闘神士」を変えてしまった",
   "en": "changed the \"Tojinshi\".",
   "max": 32
  },
  {
   "id": "12828C",
   "jp": "「闘神士」は、いくつかの　　",
   "en": "The \"Tojinshi\" split into several",
   "max": 32
  },
  {
   "id": "1282AC",
   "jp": "「流派」に分裂し、争うことと",
   "en": "\"schools\", and came to fight",
   "max": 32
  },
  {
   "id": "1282CC",
   "jp": "なった・・・　　　　　　　　",
   "en": "one another...",
   "max": 32
  },
  {
   "id": "1282EC",
   "jp": "式神と人間の協調を目指した　",
   "en": "Seeking harmony of shikigami and humans,",
   "max": 32
  },
  {
   "id": "12830C",
   "jp": "「天流」は、力こそすべて　　",
   "en": "the \"Tenryu\" fell under attack from the",
   "max": 32
  },
  {
   "id": "12832C",
   "jp": "という「地流」に攻められ、　",
   "en": "power-is-everything \"Chiryu\", and were",
   "max": 32
  },
  {
   "id": "12834C",
   "jp": "風前の灯火（ともしび）だった",
   "en": "a candle guttering in the wind...",
   "max": 29
  }
 ]
}
